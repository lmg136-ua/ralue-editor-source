Subject: [PATCH 13/19] feat: add host zoom controls and hide document title

---
 browser/css/menubar.css             |  8 +++----
 browser/src/map/handler/Map.WOPI.js | 34 +++++++++++++++++++++++++++++
 2 files changed, 38 insertions(+), 4 deletions(-)

diff --git a/browser/css/menubar.css b/browser/css/menubar.css
index d546c573..5f015af7 100644
--- a/browser/css/menubar.css
+++ b/browser/css/menubar.css
@@ -166,13 +166,13 @@ nav.hasnotebookbar [id^='save'].saved::after {
 	margin-right: 52px;
 }
 
-.main-nav.hasnotebookbar:not(.readonly) #document-titlebar {
-	/* The host application already owns the CV name and rename workflow. */
-	display: none;
+.main-nav.hasnotebookbar #document-titlebar {
+	/* The host application owns the CV name in both edit and viewing modes. */
+	display: none !important;
 }
 
 @media screen and (max-width: 900px) {
-	.main-nav.hasnotebookbar:not(.readonly) #document-titlebar {
+	.main-nav.hasnotebookbar #document-titlebar {
 		display: none;
 	}
 	.notebookbar-tabs-container {
