diff --git a/docker/ralue/build-online.sh b/docker/ralue/build-online.sh
index 8bf404cc..4f613383 100644
--- a/docker/ralue/build-online.sh
+++ b/docker/ralue/build-online.sh
@@ -4,7 +4,11 @@ set -Eeuo pipefail
 readonly source_dir=/src
 readonly stage_dir=/stage
 readonly poco_prefix=/opt/ralue-poco
-readonly online_hash=2229109277
+readonly online_hash=a1e2604001
+
+export CCACHE_DIR=/root/.cache/ccache
+export PATH="/usr/lib/ccache:${PATH}"
+ccache --max-size=5G >/dev/null
 
 # Windows may materialize this checkout with CRLF. Normalize text files only in
 # the disposable container layer so the host checkout and upstream history stay
@@ -21,6 +25,9 @@ readonly abi_flag="-D_GLIBCXX_USE_CXX11_ABI=${engine_abi}"
 readonly poco_compat_flag="-DPOCO_NEW_STATE_ON_MOVE=0"
 echo "Ralue build: engine C++ ABI is ${engine_abi}"
 
+# Ralue needs its own browser asset revision even while the upstream document
+# engine remains pinned. Otherwise browsers can reuse Collabora bundles cached
+# under the upstream hash after a Ralue deployment.
 printf '%s\n' "${online_hash}" > "${source_dir}/dist_git_hash"
 
 cd "${source_dir}"
@@ -33,7 +40,12 @@ LDFLAGS="-L${poco_prefix}/lib" \
   --prefix=/usr \
   --sysconfdir=/etc \
   --localstatedir=/var \
+  --with-app-package-name=app.ralue.editor \
+  --with-app-name="Ralue Editor" \
+  --with-vendor="Ralue" \
+  --with-info-url=https://www.ralue.app \
   --enable-silent-rules \
+  --disable-feature-lock \
   --disable-werror \
   --disable-tests \
   --with-system-poco \
diff --git a/docker/ralue/build.ps1 b/docker/ralue/build.ps1
index d81a537a..6cf71c64 100644
--- a/docker/ralue/build.ps1
+++ b/docker/ralue/build.ps1
@@ -1,5 +1,5 @@
 param(
-    [string]$Tag = "ralue/editor:upstream-26.04.2.4",
+    [string]$Tag = "ralue/editor:mvp-26.04.2.4",
     [int]$Jobs = 0
 )
 
@@ -37,4 +37,3 @@ if (Test-Path "$progress\cache-next") {
 }
 
 Write-Host "Built $Tag successfully. Re-running this script will reuse the saved cache."
-
diff --git a/docker/ralue/compose.yml b/docker/ralue/compose.yml
new file mode 100644
index 00000000..f2b1e2f1
--- /dev/null
+++ b/docker/ralue/compose.yml
@@ -0,0 +1,27 @@
+services:
+  editor:
+    image: ralue/editor:mvp-26.04.2.4
+    container_name: ralue-editor
+    restart: unless-stopped
+    ports:
+      - "9982:9980"
+    environment:
+      DONT_GEN_SSL_CERT: "true"
+      domain: "localhost|127\\.0\\.0\\.1|host\\.docker\\.internal"
+    command:
+      - "--o:ssl.enable=false"
+      - "--o:welcome.enable=false"
+      - "--o:allow_update_popup=false"
+      - "--o:home_mode.enable=false"
+      - "--o:product_name=Ralue Editor"
+      - "--o:user_interface.brandProductName=Ralue Editor"
+      - "--o:user_interface.brandProductURL=https://www.ralue.app"
+      - "--o:user_interface.logoURL=/browser/dist/images/ralue-logo.png"
+      - "--o:logging.level=warning"
+      - "--o:net.frame_ancestors=http://localhost:3001 http://127.0.0.1:3001"
+    healthcheck:
+      test: ["CMD", "/usr/bin/coolconfig", "get", "logging.level"]
+      interval: 15s
+      timeout: 5s
+      retries: 10
+      start_period: 30s
