+		// Writer keeps the page horizontally centred. Anchoring an animated zoom
+		// to the caret first moves the page towards the caret and the Writer
+		// layout then recentres it, which produces a visible sideways jump. Keep
+		// caret-anchored zoom for the document types that need it, but let Writer
+		// use the stable viewport centre below.
+		if (this._docLayer && this._docLayer._docType !== 'text' && app.file.textCursor.visible && app.activeDocument.activeLayout.viewedRectangle.containsPoint(app.file.textCursor.rectangle.center)) {
