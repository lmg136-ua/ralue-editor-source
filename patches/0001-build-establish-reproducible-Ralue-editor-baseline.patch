@@ -0,0 +1,23 @@
+services:
+  editor:
+    image: ralue/editor:upstream-26.04.2.4
+    container_name: ralue-editor-source-baseline
+    restart: unless-stopped
+    ports:
+      - "9982:9980"
+    environment:
+      DONT_GEN_SSL_CERT: "true"
+      domain: "localhost|127\\.0\\.0\\.1|host\\.docker\\.internal"
+    command:
+      - "--o:ssl.enable=false"
+      - "--o:welcome.enable=false"
+      - "--o:home_mode.enable=false"
+      - "--o:logging.level=warning"
+      - "--o:net.frame_ancestors=http://localhost:3001 http://127.0.0.1:3001"
+    healthcheck:
+      test: ["CMD", "/usr/bin/coolconfig", "get", "logging.level"]
+      interval: 15s
+      timeout: 5s
+      retries: 10
+      start_period: 30s
+
