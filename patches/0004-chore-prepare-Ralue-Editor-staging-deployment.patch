diff --git a/docker/ralue/compose.staging.yml b/docker/ralue/compose.staging.yml
new file mode 100644
index 00000000..2e0922d3
--- /dev/null
+++ b/docker/ralue/compose.staging.yml
@@ -0,0 +1,41 @@
+services:
+  editor:
+    image: ralue/editor:mvp-26.04.2.4
+    container_name: ralue-editor-staging
+    restart: unless-stopped
+    init: true
+    stop_grace_period: 1m
+    ports:
+      - "127.0.0.1:${RALUE_EDITOR_PORT:-9980}:9980"
+    environment:
+      DONT_GEN_SSL_CERT: "true"
+      domain: "${RALUE_WOPI_HOST_REGEX:?Set RALUE_WOPI_HOST_REGEX in staging.env}"
+    command:
+      - "--o:ssl.enable=false"
+      - "--o:ssl.termination=true"
+      - "--o:welcome.enable=false"
+      - "--o:allow_update_popup=false"
+      - "--o:home_mode.enable=false"
+      - "--o:product_name=Ralue Editor"
+      - "--o:user_interface.brandProductName=Ralue Editor"
+      - "--o:user_interface.brandProductURL=https://www.ralue.app"
+      - "--o:user_interface.logoURL=/browser/dist/images/ralue-logo.png"
+      - "--o:logging.level=${RALUE_LOG_LEVEL:-warning}"
+      - "--o:net.frame_ancestors=${RALUE_FRAME_ANCESTORS:?Set RALUE_FRAME_ANCESTORS in staging.env}"
+    healthcheck:
+      test: ["CMD", "/usr/bin/coolconfig", "get", "logging.level"]
+      interval: 15s
+      timeout: 5s
+      retries: 10
+      start_period: 30s
+    mem_limit: "${RALUE_MEMORY_LIMIT:-4g}"
+    mem_reservation: "${RALUE_MEMORY_RESERVATION:-2g}"
+    cpus: "${RALUE_CPU_LIMIT:-2.0}"
+    pids_limit: 1024
+    shm_size: "${RALUE_SHM_SIZE:-1g}"
+    logging:
+      driver: json-file
+      options:
+        max-size: "10m"
+        max-file: "5"
+
diff --git a/docker/ralue/staging.env.example b/docker/ralue/staging.env.example
new file mode 100644
index 00000000..84ac4949
--- /dev/null
+++ b/docker/ralue/staging.env.example
@@ -0,0 +1,19 @@
+# Public hostname served by Caddy. Do not add https:// here.
+RALUE_EDITOR_DOMAIN=editor.example.com
+
+# Ralue Editor only listens on loopback; Caddy is the public entry point.
+RALUE_EDITOR_PORT=9980
+
+# Regex of WOPI hosts allowed to connect to the editor.
+# Escape each literal dot with one backslash in this unquoted env value.
+RALUE_WOPI_HOST_REGEX=staging\.example\.com
+
+# Space-separated HTTPS origins allowed to embed the editor in an iframe.
+RALUE_FRAME_ANCESTORS=https://staging.example.com
+
+# Safe starting limits for a small staging server; tune from measured usage.
+RALUE_MEMORY_LIMIT=4g
+RALUE_MEMORY_RESERVATION=2g
+RALUE_CPU_LIMIT=2.0
+RALUE_SHM_SIZE=1g
+RALUE_LOG_LEVEL=warning
